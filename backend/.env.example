# Copie este arquivo para ".env" (na raiz de backend/) e preencha com valores reais.
# O .env é ignorado pelo Git — nunca commite credenciais reais.

# Servidor
PORT=5000
NODE_ENV=development

# Banco de dados (SQL Server)
DB_USER=sa
DB_PASSWORD=
DB_DATABASE=controla_facil
DB_SERVER=localhost
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Autenticação
JWT_SECRET=

# E-mail (usado para confirmação de cadastro, recuperação de senha etc.)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# Integração Mercado Livre
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=

# URLs usadas para montar links absolutos (ex.: imagens, callback de e-mail)
URL_API=http://localhost:5000
URL_FRONTEND=http://localhost:5173

# Pasta de uploads em produção (opcional; em dev usa-se backend/uploads)
# UPLOAD_DIR=
